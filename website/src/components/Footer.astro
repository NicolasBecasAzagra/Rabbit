---
import { url } from '../lib/paths';
import { meta } from '../data/project';

const year = new Date().getFullYear();

const productLinks = [
  { label: 'Roadmap', href: url('/roadmap') },
  { label: 'Benchmarks', href: url('/benchmarks') },
  { label: 'Download', href: url('/download') },
  { label: 'Changelog', href: url('/changelog') },
];

const resourceLinks = [
  { label: 'Docs', href: url('/docs') },
  { label: 'FAQ', href: url('/faq') },
  { label: 'Measurement report', href: `${meta.repo}/blob/main/REPORT.md` },
  { label: 'GitHub', href: meta.repo },
];
---

<footer class="site-footer">
  <div class="wrapper footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-name">{meta.name}</p>
        <p class="footer-description">{meta.description}</p>
      </div>

      <nav class="footer-nav" aria-labelledby="footer-product">
        <p id="footer-product" class="footer-heading">Product</p>
        <ul>
          {productLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>

      <nav class="footer-nav" aria-labelledby="footer-resources">
        <p id="footer-resources" class="footer-heading">Resources</p>
        <ul>
          {resourceLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="footer-legal">
      <p>
        <a href={meta.licenseUrl}>Licensed {meta.license}</a>
        <span aria-hidden="true">·</span>
        <span>{meta.toolchain}</span>
        <span aria-hidden="true">·</span>
        <span>© {year} {meta.author}</span>
      </p>
      <p class="footer-disclaimer">This is a research kernel, not a production operating system.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-3xl) var(--space-xl);
    background: var(--surface);
    border-top: 1px solid var(--hairline);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-xl);
    margin-block-end: var(--space-xl);
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--font-medium);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .footer-description {
    margin-block-start: var(--space-xs);
    max-width: 40ch;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-secondary);
  }

  .footer-heading {
    margin-block-end: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .footer-nav ul {
    display: grid;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
  }

  .footer-nav a {
    color: var(--ink-secondary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-nav a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .footer-legal {
    padding-block-start: var(--space-lg);
    border-top: 1px solid var(--hairline);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .footer-legal p {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    align-items: center;
  }

  .footer-legal a {
    color: var(--ink-secondary);
    text-decoration: none;
  }

  .footer-legal a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .footer-disclaimer {
    margin-block-start: var(--space-sm);
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>
