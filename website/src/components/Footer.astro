---
import { url } from '../lib/paths';
import { meta } from '../data/project';
import EarsMark from './EarsMark.astro';

const year = new Date().getFullYear();

const groups = [
  {
    title: 'Product',
    links: [
      { label: 'Roadmap', href: url('/roadmap') },
      { label: 'Benchmarks', href: url('/benchmarks') },
      { label: 'Download', href: url('/download') },
      { label: 'Changelog', href: url('/changelog') },
    ],
  },
  {
    title: 'Resources',
    links: [
      { label: 'Docs', href: url('/docs') },
      { label: 'FAQ', href: url('/faq') },
      { label: 'Measurement report', href: `${meta.repo}/blob/main/REPORT.md` },
    ],
  },
  {
    title: 'Contact',
    links: [
      { label: 'Repository', href: meta.repo },
      { label: 'GitHub', href: 'https://github.com/NicolasBecasAzagra', external: true },
      { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nicolasbecas', external: true },
    ],
  },
];
---

<footer class="site-footer on-black">
  <div class="wrapper">
    <div class="footer-grid">
      <p class="footer-description">{meta.description}</p>
      {
        groups.map((group) => (
          <nav class="footer-nav" aria-label={group.title}>
            <p class="footer-heading">{group.title}</p>
            <ul role="list">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} rel={'external' in link ? 'noopener noreferrer' : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="footer-legal">
      <a href={meta.licenseUrl}>Licensed {meta.license}</a>
      <span>{meta.toolchain}</span>
      <span>© {year} {meta.author}</span>
      <span>This is a research kernel, not a production operating system.</span>
    </div>
  </div>

  <div class="footer-mark" aria-hidden="true">
    <div class="footer-lockup">
      <span class="footer-word">Rabbit</span>
      <EarsMark class="footer-ears" />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block-start: var(--space-3xl);
    overflow: hidden;
    border-block-start: 1px solid var(--rule);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-xl);
    margin-block-end: var(--space-xl);
  }

  .footer-description {
    max-width: 32ch;
    font-size: var(--text-md);
    line-height: var(--leading-normal);
    color: var(--ink);
  }

  .footer-heading {
    margin-block-end: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--ink-secondary);
  }

  .footer-nav ul {
    display: grid;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
  }

  .footer-nav a,
  .footer-legal a {
    color: var(--ink);
    font-size: var(--text-base);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--hairline);
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  .footer-legal a {
    font-size: var(--text-sm);
  }

  /* The word, as in the hero, cropped by the bottom edge, with the ears beside it */
  .footer-mark {
    margin-block-start: var(--space-xl);
    font-size: clamp(3.5rem, 24vw, 19rem);
  }

  .footer-lockup {
    position: relative;
    width: max-content;
    margin-inline-start: max(var(--space-md), calc((100% - var(--max-content)) / 2));
    margin-block-end: -0.3em;
  }

  .footer-word {
    display: block;
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: var(--ink);
    margin-inline-start: -0.04em;
  }

  .footer-lockup :global(.footer-ears) {
    position: absolute;
    inset-block-start: -0.1em;
    inset-inline-start: calc(100% + 0.1em);
    width: 1.15em;
    height: 1.15em;
    max-width: none;
    fill: none;
    stroke: var(--ink);
    stroke-width: 3px;
  }

  .footer-lockup :global(.footer-ears path) {
    vector-effect: non-scaling-stroke;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-lg);
    }

    .footer-description {
      grid-column: 1 / -1;
    }
  }
</style>
