---
import { meta } from '../data/project';
import { url } from '../lib/paths';

// The only addresses of the contact line: the repository and the profiles of the author.
const contact = [
  { label: 'Repository', href: meta.repo },
  { label: 'GitHub', href: 'https://github.com/NicolasBecasAzagra' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/nicolasbecas' },
];
---

<section class="closing on-paper" aria-labelledby="cta-title">
  <div class="wrapper">
    <h2 id="cta-title" class="closing-claim">
      The kernel is the comparison. Every measurement is published, every loss included.
    </h2>

    <div class="closing-lines">
      <nav class="closing-nav" aria-label="Next steps">
        <a href={url('/docs')}>Docs</a>
        <a href={url('/roadmap')}>Roadmap</a>
        <a href={url('/benchmarks')}>Benchmarks</a>
      </nav>

      <p class="closing-contact">
        <span>{meta.author}</span>
        {
          contact.map((c) => (
            <a href={c.href} rel="noopener noreferrer">{c.label}</a>
          ))
        }
      </p>
    </div>
  </div>
</section>

<style>
  .closing {
    padding-block: var(--space-3xl);
    border-block-start: 1px solid var(--ink);
  }

  .closing-claim {
    max-width: 22ch;
    font-size: clamp(2rem, 1.1rem + 3.2vw, 4rem);
    line-height: 1.05;
    font-weight: var(--font-medium);
    letter-spacing: -0.03em;
  }

  .closing-lines {
    display: grid;
    gap: var(--space-md);
    margin-block-start: var(--space-xl);
    padding-block-start: var(--space-md);
    border-block-start: 1px solid var(--hairline);
    font-size: var(--text-base);
  }

  .closing-nav,
  .closing-contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    font-weight: var(--font-medium);
  }

  .closing-contact span {
    color: var(--ink-secondary);
    font-weight: var(--font-regular);
  }

  @media (max-width: 640px) {
    .closing {
      padding-block: var(--space-2xl);
    }
  }
</style>
