---
import { meta } from '../data/project';
import { url } from '../lib/paths';
---

<section class="cta-section" aria-labelledby="cta-title">
  <div class="wrapper">
    <div class="cta-rule" aria-hidden="true"></div>
    <h2 id="cta-title" class="cta-claim">
      The kernel is the comparison. Every measurement is published, every loss included.
    </h2>
    <nav class="cta-links" aria-label="Next steps">
      <a href={url('/docs')}>Docs</a>
      <a href={url('/roadmap')}>Roadmap</a>
      <a href={url('/benchmarks')}>Benchmarks</a>
      <a href={meta.repo}>GitHub</a>
    </nav>
  </div>
</section>

<style>
  .cta-section {
    padding-block: var(--space-3xl);
    border-top: 1px solid var(--hairline);
  }

  .cta-claim {
    max-width: var(--measure);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    font-weight: var(--font-medium);
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-block-end: var(--space-lg);
    text-wrap: balance;
  }

  .cta-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .cta-links a {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--ink-secondary);
    text-decoration: none;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .cta-links a:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .cta-links a:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--ring);
  }

  .cta-links a:active {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
