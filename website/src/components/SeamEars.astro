---
// The chapter mark below the hero: one large outline ear pair at a seam
// between two slabs, cropped by it, with the stroke of the hero ears.
// Decorative, so hidden from assistive technology. It never reaches content:
// `reach` is how far the ears extend from the seam, and each slab keeps its
// text out of that corner (checked at 1100, 1280 and 1440).
import EarsMark from './EarsMark.astro';

export interface Props {
  /** Which seam: the top edge of the slab (ears hang down) or its bottom edge (ears rise). */
  edge?: 'top' | 'bottom';
  side?: 'left' | 'right';
  /** How far the ears extend from the seam. */
  reach?: string;
}

const { edge = 'top', side = 'right', reach = '12rem' } = Astro.props;
---

<div class={`seam seam-${edge} seam-${side}`} style={`--reach: ${reach}`} aria-hidden="true">
  <EarsMark class="seam-ears" />
</div>

<style>
  .seam {
    display: none;
  }

  @media (min-width: 1100px) {
    .seam {
      display: block;
      position: absolute;
      inset-inline: 0;
      height: var(--reach);
      overflow: hidden;
      pointer-events: none;
      z-index: -1;
      --gutter: max(var(--space-md), calc((100% - var(--max-content)) / 2));
    }

    .seam-top {
      inset-block-start: 0;
    }

    .seam-bottom {
      inset-block-end: 0;
    }

    .seam :global(.seam-ears) {
      position: absolute;
      width: 30rem;
      height: 30rem;
      max-width: none;
      fill: none;
      stroke: var(--ink);
      stroke-width: 3px;
    }

    /* the pair spans 28% to 72% of the drawing: 8.4rem of empty margin on each side */
    .seam-right :global(.seam-ears) {
      inset-inline-end: calc(var(--gutter) - 8.4rem);
    }

    .seam-left :global(.seam-ears) {
      inset-inline-start: calc(var(--gutter) - 8.4rem);
    }

    /* top seam: the lower ends of the ears hang `reach` below the edge */
    .seam-top :global(.seam-ears) {
      inset-block-start: calc(var(--reach) - 28.125rem);
    }

    /* bottom seam: the upper ends of the ears rise `reach` above the edge */
    .seam-bottom :global(.seam-ears) {
      inset-block-start: -1.875rem;
    }

    .seam :global(.seam-ears path) {
      vector-effect: non-scaling-stroke;
    }
  }
</style>
