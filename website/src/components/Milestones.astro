---
import Mark from './Mark.astro';
import { loadReadme } from '../lib/readme';
import { url } from '../lib/paths';

// Everything here is read from the README of the repository at build time.
const { status, next } = loadReadme();
const [upNext, ...later] = next;
---

<section class="road on-paper" id="roadmap" aria-labelledby="road-title">
  <div class="wrapper">
    <h2 id="road-title" class="road-title">What is delivered, and what comes next</h2>

    <div class="road-grid">
      <div class="road-done">
        <p class="road-lead">{status.length} milestones delivered.</p>
        <ol class="strip" role="list">
          {
            status.map((row) => (
              <li class="strip-item">
                <Mark kind="solid" label="Done:" />
                <span class="strip-id">{row.id}</span>
              </li>
            ))
          }
        </ol>
        <details class="delivered">
          <summary>What each one delivered</summary>
          <dl>
            {
              status.map((row) => (
                <div>
                  <dt>{row.id}</dt>
                  <dd>{row.delivers}</dd>
                </div>
              ))
            }
          </dl>
        </details>
      </div>

      <div class="road-next">
        <div class="up-next">
          <Mark kind="hollow" label="Open:" class="up-mark" />
          <div>
            <h3 class="up-title">{upNext.title}</h3>
            <p class="up-why">{upNext.why}</p>
            <p class="up-issues">
              {
                upNext.issues.map((issue) => (
                  <a href={issue.url}>Issue {issue.number}</a>
                ))
              }
            </p>
          </div>
        </div>

        <ul class="later" role="list">
          {
            later.map((row) => (
              <li class="later-row">
                <Mark kind={row.deferred ? 'hatch' : 'hollow'} label={row.deferred ? 'Deferred:' : 'Open:'} />
                <div>
                  <p class="later-title">{row.title}</p>
                  <p class="later-why">{row.why}</p>
                  <p class="later-issues">
                    {row.issues.map((issue) => (
                      <a href={issue.url}>Issue {issue.number}</a>
                    ))}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>

        <p class="road-more"><a href={url('/roadmap')}>The full roadmap, with every exit criterion</a></p>
      </div>
    </div>
  </div>
</section>

<style>
  .road {
    padding-block: var(--space-3xl);
  }

  .road-title {
    font-size: clamp(2rem, 1.1rem + 3.2vw, 4rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.04em;
    max-width: 18ch;
    margin-block-end: var(--space-xl);
  }

  .road-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .road-done {
    position: sticky;
    inset-block-start: 5rem;
  }

  .road-lead {
    font-size: var(--text-lg);
    font-weight: var(--font-medium);
    letter-spacing: -0.01em;
    margin-block-end: var(--space-md);
  }

  .strip {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
  }

  .strip-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .strip-item :global(.mark) {
    --mark-size: 0.875rem;
  }

  .strip-id {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .delivered {
    margin-block-start: var(--space-lg);
    border-block-start: 1px solid var(--hairline);
  }

  .delivered summary {
    padding-block: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    cursor: pointer;
  }

  .delivered dl > div {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-sm);
    padding-block: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  .delivered dt {
    font-family: var(--font-mono);
    color: var(--ink);
  }

  .delivered dd {
    margin: 0;
  }

  /* The next milestone carries the weight */
  .up-next {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-md);
    padding-block: 0 var(--space-lg);
    border-block-end: 1px solid var(--ink);
  }

  .up-next :global(.up-mark) {
    --mark-size: 1.75rem;
    align-self: start;
    margin-block-start: 0.5rem;
  }

  .up-title {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    font-weight: var(--font-medium);
    letter-spacing: -0.03em;
  }

  .up-why {
    margin-block-start: var(--space-sm);
    max-width: var(--measure);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-secondary);
    text-wrap: pretty;
  }

  .up-issues,
  .later-issues {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin-block-start: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .later {
    list-style: none;
    padding: 0;
  }

  .later-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--hairline);
  }

  .later-row :global(.mark) {
    --mark-size: 1.125rem;
    align-self: start;
    margin-block-start: 0.2rem;
  }

  .later-title {
    font-size: var(--text-md);
    font-weight: var(--font-medium);
    letter-spacing: -0.01em;
  }

  .later-why {
    max-width: var(--measure);
    margin-block-start: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  .road-more {
    margin-block-start: var(--space-lg);
    font-weight: var(--font-medium);
  }

  @media (max-width: 960px) {
    .road-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .road-next {
      order: -1;
    }

    .road-done {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .road {
      padding-block: var(--space-2xl);
    }

    .up-title {
      font-size: 1.75rem;
    }
  }
</style>
