---
import { build } from '../../data/project';
---

<section class="requirements-section" aria-labelledby="requirements-title">
  <div class="wrapper">
    <header class="section-header">
      <p class="section-eyebrow">Requirements</p>
      <h2 id="requirements-title" class="text-title">What you need to build</h2>
    </header>

    <ul class="requirement-list">
      {
        build.requirements.map((req) => (
          <li class="requirement-card">
            <h3>{req.name}</h3>
            <p class="text-body">{req.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .requirements-section {
    padding-block: var(--space-3xl);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-eyebrow {
    margin-block-end: var(--space-sm);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .section-header h2 {
    margin-block-end: var(--space-sm);
  }

  .requirement-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    list-style: none;
    padding: 0;
  }

  .requirement-card {
    padding: var(--space-md);
    border-radius: var(--radius-card);
    background: var(--surface);
    border: 1px solid var(--hairline);
  }

  .requirement-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-block-end: var(--space-xs);
  }

  @media (max-width: 760px) {
    .requirement-list {
      grid-template-columns: 1fr;
    }
  }
</style>
