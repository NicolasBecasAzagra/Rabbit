---
import { url } from '../lib/paths';
import { meta } from '../data/project';
import EarsMark from './EarsMark.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || url('');
const links = [
  { label: 'Roadmap', href: url('/roadmap') },
  { label: 'Benchmarks', href: url('/benchmarks') },
  { label: 'Docs', href: url('/docs') },
  { label: 'Download', href: url('/download') },
  { label: 'FAQ', href: url('/faq') },
  { label: 'Changelog', href: url('/changelog') },
];
---

<header class="site-header on-ink">
  <div class="wrapper header-inner">
    <a class="wordmark" href={url('/')} aria-label={`${meta.name} home`}>
      <EarsMark class="wordmark-icon" />
      <span class="wordmark-text">{meta.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          links.map((link) => {
            const isCurrent = pathname === link.href || (link.href !== url('/') && pathname.startsWith(link.href));
            return (
              <li>
                <a href={link.href} aria-current={isCurrent ? 'page' : undefined}>{link.label}</a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="button button-secondary button-small" href={url('/docs')}>Docs</a>
      <a class="button button-primary button-small" href={meta.repo}>GitHub</a>
    </div>

    <details class="mobile-menu">
      <summary class="menu-toggle" aria-label="Menu">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </summary>
      <div class="mobile-menu-panel">
        <div class="wrapper">
          <ul class="mobile-nav-list">
            {
              links.map((link) => {
                const isCurrent = pathname === link.href || (link.href !== url('/') && pathname.startsWith(link.href));
                return (
                  <li>
                    <a href={link.href} aria-current={isCurrent ? 'page' : undefined}>{link.label}</a>
                  </li>
                );
              })
            }
          </ul>
          <div class="mobile-actions">
            <a class="button button-secondary" href={url('/docs')}>Docs</a>
            <a class="button button-primary" href={meta.repo}>GitHub</a>
          </div>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    inset-inline: 0;
    z-index: 100;
    height: 4rem;
    background: #000000;
    border-bottom: 1px solid var(--hairline);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space);
    height: 100%;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--ink);
  }

  :global(.wordmark-icon) {
    flex: none;
    width: 24px;
    height: 24px;
    color: var(--ink);
  }

  .site-nav {
    display: flex;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    list-style: none;
    padding: 0;
  }

  .nav-list a {
    display: block;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--ink-secondary);
    font-family: var(--font-body);
    font-size: var(--text-caption);
    text-decoration: none;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-list a:hover {
    color: var(--ink);
    background: var(--surface);
  }

  .nav-list a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1.5px;
  }

  .nav-list a:active {
    background: var(--surface-2);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: transparent;
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    cursor: pointer;
  }

  .menu-toggle:hover {
    background: var(--surface);
  }

  .menu-toggle:active {
    background: var(--surface-2);
  }

  .menu-toggle span {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background: var(--ink);
    transition: transform 150ms ease;
  }

  .mobile-menu {
    display: none;
  }

  .mobile-menu summary {
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu-panel {
    position: absolute;
    inset-block-start: 4rem;
    inset-inline: var(--space-md);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background: var(--canvas);
    box-shadow: var(--shadow-float);
    padding: var(--space-md);
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-xs);
    margin-block-end: var(--space-md);
  }

  .mobile-nav-list a {
    display: block;
    padding: var(--space-sm) 0;
    color: var(--ink-secondary);
    font-family: var(--font-body);
    font-size: var(--text-base);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline);
    transition: color var(--transition-fast);
  }

  .mobile-nav-list a:hover,
  .mobile-nav-list a[aria-current="page"] {
    color: var(--ink);
  }

  .mobile-nav-list a:active {
    color: var(--accent);
  }

  .mobile-actions {
    display: flex;
    gap: var(--space-sm);
  }

  @media (max-width: 900px) {
    .site-nav,
    .header-actions {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  (function () {
    const details = document.querySelector<HTMLDetailsElement>('.mobile-menu');
    const summary = details?.querySelector('.menu-toggle');
    if (!details || !summary) return;

    details.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        details.open = false;
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && details.open) {
        e.preventDefault();
        details.open = false;
        (summary as HTMLElement).focus();
      }
    });
  })();
</script>
