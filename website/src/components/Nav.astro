---
import { url } from '../lib/paths';
import { meta } from '../data/project';
import EarsMark from './EarsMark.astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || url('');
const home = url('/');
// Sections of the home page are anchors; the pages mark themselves current.
const links = [
  { label: 'Aim', href: `${home}#aim`, section: 'aim' },
  { label: 'Tool policy', href: `${home}#policy`, section: 'policy' },
  { label: 'Layers', href: `${home}#layers`, section: 'layers' },
  { label: 'Benchmarks', href: `${home}#benchmarks`, section: 'benchmarks', page: url('/benchmarks') },
  { label: 'Roadmap', href: `${home}#roadmap`, section: 'roadmap', page: url('/roadmap') },
  { label: 'Docs', href: url('/docs'), page: url('/docs') },
  { label: 'Download', href: url('/download'), page: url('/download') },
  { label: 'FAQ', href: url('/faq'), page: url('/faq'), mobileOnly: true },
  { label: 'Changelog', href: url('/changelog'), page: url('/changelog'), mobileOnly: true },
];
const isPage = (link: { page?: string }) => Boolean(link.page && pathname.startsWith(link.page));
---

<header class="site-header on-ink">
  <div class="wrapper header-inner">
    <a class="wordmark" href={url('/')} aria-label={`${meta.name} home`}>
      <EarsMark class="wordmark-icon" />
      <span class="wordmark-text">{meta.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          links.filter((link) => !link.mobileOnly).map((link) => (
            <li>
              <a href={link.href} data-section={link.section} aria-current={isPage(link) ? 'page' : undefined}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <a class="button button-primary button-small" href={meta.repo}>GitHub</a>
    </div>

    <details class="mobile-menu">
      <summary class="menu-toggle">
        <span class="menu-open">Menu</span>
        <span class="menu-close">Close</span>
      </summary>
      <div class="mobile-menu-panel">
        <div class="wrapper">
          <ul class="mobile-nav-list">
            {
              links.map((link) => (
                <li>
                  <a href={link.href} data-section={link.section} aria-current={isPage(link) ? 'page' : undefined}>{link.label}</a>
                </li>
              ))
            }
          </ul>
          <div class="mobile-actions">
            <a class="button button-primary" href={meta.repo}>GitHub</a>
          </div>
        </div>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    inset-inline: 0;
    z-index: 100;
    height: 4rem;
    background: var(--canvas);
    border-bottom: 1px solid var(--hairline);
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space);
    height: 100%;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--ink);
  }

  :global(.wordmark-icon) {
    flex: none;
    width: 24px;
    height: 24px;
    color: var(--ink);
  }

  .site-nav {
    display: flex;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    padding: 0;
  }

  .nav-list a {
    display: block;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--ink-secondary);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .nav-list a:hover {
    color: var(--ink);
    background: var(--surface);
  }

  .nav-list a[aria-current="page"],
  .nav-list a[aria-current="location"] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1.5px;
  }

  .nav-list a:active {
    background: var(--surface-2);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    height: 2.25rem;
    padding-inline: 0.875rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--ink);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    cursor: pointer;
  }

  .menu-toggle:hover {
    background: var(--surface-2);
  }

  .menu-close,
  .mobile-menu[open] .menu-open {
    display: none;
  }

  .mobile-menu[open] .menu-close {
    display: inline;
  }

  .mobile-menu {
    display: none;
  }

  .mobile-menu summary {
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu-panel {
    position: absolute;
    inset-block-start: 4rem;
    inset-inline: 0;
    border-block: 1px solid var(--rule);
    background: var(--canvas);
    padding: var(--space-md) 0 var(--space-lg);
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-xs);
    margin-block-end: var(--space-md);
  }

  .mobile-nav-list a {
    display: block;
    padding: var(--space-sm) 0;
    color: var(--ink-secondary);
    font-family: var(--font-body);
    font-size: var(--text-base);
    text-decoration: none;
    border-bottom: 1px solid var(--hairline);
    transition: color var(--transition-fast);
  }

  .mobile-nav-list a:hover {
    color: var(--ink);
  }

  .mobile-nav-list a[aria-current="page"],
  .mobile-nav-list a[aria-current="location"] {
    color: var(--ink);
    font-weight: var(--font-medium);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .mobile-actions {
    display: flex;
    gap: var(--space-sm);
  }

  @media (max-width: 900px) {
    .site-nav,
    .header-actions {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  (function () {
    const details = document.querySelector<HTMLDetailsElement>('.mobile-menu');
    const summary = details?.querySelector<HTMLElement>('.menu-toggle');
    if (details && summary) {
      details.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          details.open = false;
        });
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && details.open) {
          e.preventDefault();
          details.open = false;
          summary.focus();
        }
      });

      document.addEventListener('click', (e) => {
        if (details.open && !details.contains(e.target as Node)) details.open = false;
      });
    }

    // Current section on the home page, shown without colour: aria-current
    // moves to the link of the section in view, and the style underlines it.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('a[data-section]')];
    const sections = links
      .map((link) => document.getElementById(link.dataset.section ?? ''))
      .filter((el): el is HTMLElement => Boolean(el) && document.querySelector('main')?.contains(el) === true);
    if (!sections.length || !('IntersectionObserver' in window)) return;
    const visible = new Set<string>();
    const setCurrent = () => {
      const current = sections.find((el) => visible.has(el.id));
      links.forEach((link) => {
        if (link.getAttribute('aria-current') === 'page') return;
        if (current && link.dataset.section === current.id) link.setAttribute('aria-current', 'location');
        else if (link.getAttribute('aria-current') === 'location') link.removeAttribute('aria-current');
      });
    };
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        });
        setCurrent();
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((el) => observer.observe(el));
  })();
</script>
