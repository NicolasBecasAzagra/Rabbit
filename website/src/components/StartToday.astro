---
import { meta, build } from '../data/project';
import { url } from '../lib/paths';
import SeamEars from './SeamEars.astro';

// Real commands only: the clone of the repository and the two commands of the data.
const [buildCmd, runCmd] = build.commands;
const commands = [
  { cmd: `git clone ${meta.repo}.git`, what: 'Clone the repository.' },
  { cmd: buildCmd.cmd, what: buildCmd.what },
  { cmd: runCmd.cmd, what: runCmd.what },
];
---

<section id="run" class="run on-ink" data-runit aria-labelledby="start-title">
  <SeamEars />
  <div class="wrapper run-grid">
    <header class="run-head">
      <h2 id="start-title" class="run-title">Run it today</h2>
      <p class="run-lead">
        Clone, build, boot. The repository has everything: the kernel, the runtime, the agent, the
        benchmark rig.
      </p>
      <p class="run-note">
        The boot ends with exit status 33 when it is clean. The toolchain is {meta.toolchain}.
      </p>
    </header>

    <div class="run-body">
      <ol class="commands" role="list">
        {
          commands.map((c) => (
            <li>
              <div class="command-row">
                <code class="command" tabindex="0">{c.cmd}</code>
                <button type="button" class="copy" data-copy={c.cmd} aria-label={`Copy the command: ${c.cmd}`}>
                  <span class="copy-label">Copy</span>
                </button>
              </div>
              <span class="command-what">{c.what}</span>
              <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
            </li>
          ))
        }
      </ol>

      <ul class="run-links" role="list">
        <li><a href={url('/download')}>Download and build</a></li>
        <li><a href={url('/docs')}>Read the docs</a></li>
        <li><a href={url('/changelog')}>Changelog</a></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .run {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-3xl);
  }

  .run-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-2xl);
    align-items: start;
  }

  .run-title {
    font-size: clamp(2rem, 1.1rem + 3.2vw, 4rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .run-lead {
    margin-block-start: var(--space-lg);
    max-width: 40ch;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--ink-secondary);
  }

  .run-note {
    margin-block-start: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  .commands {
    list-style: none;
    padding: 0;
    border-block-start: 1px solid var(--ink);
  }

  .commands li {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-md);
    border-block-end: 1px solid var(--hairline);
  }

  .command-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-md);
  }

  /* One line, never broken mid-token: it scrolls inside the block */
  .command {
    display: block;
    overflow-x: auto;
    white-space: nowrap;
    padding-block: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-md);
    color: var(--ink);
  }

  .copy {
    min-width: 4.5rem;
    height: 2.25rem;
    padding-inline: 0.875rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .copy:hover {
    background: var(--surface-2);
  }

  .command::before {
    content: '$ ';
    color: var(--ink-secondary);
  }

  .command-what {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  .run-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    margin-block-start: var(--space-lg);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
  }

  @media (max-width: 960px) {
    .run-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }

  @media (max-width: 640px) {
    .run {
      padding-block: var(--space-2xl);
    }
  }
</style>

<script>
  // Copy with the clipboard API; a hidden textarea is the fallback. The state
  // is a text change ("Copied"), never a colour change.
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.appendChild(area);
      area.select();
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch {
        ok = false;
      }
      area.remove();
      return ok;
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    const label = button.querySelector('.copy-label');
    const status = button.closest('li')?.querySelector('[data-copy-status]');
    button.addEventListener('click', async () => {
      const ok = await copyText(button.dataset.copy ?? '');
      if (label) label.textContent = ok ? 'Copied' : 'Select it';
      if (status) status.textContent = ok ? 'Copied to the clipboard' : 'Copy failed: select the command and copy it';
      setTimeout(() => {
        if (label) label.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 2000);
    });
  });
</script>
