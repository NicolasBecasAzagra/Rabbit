---
import { layers } from '../data/project';
import EarsMark from './EarsMark.astro';
---

<section class="layers-section on-paper" aria-labelledby="layers-title">
  <div class="wrapper">
    <header class="section-header">
      <h2 id="layers-title" class="text-title">
        <EarsMark class="layers-ears" />
        <span>Four layers, one system</span>
      </h2>
      <p class="text-lead">
        Each layer owns a single responsibility. Together they run a local model and let it act.
      </p>
    </header>

    <ul class="stack-of-layers" role="list">
      {
        layers.map((layer) => (
          <li class="layer">
            <div class="layer-slab on-ink">
              <h3 class="layer-name">{layer.name}</h3>
              <p class="layer-role">{layer.role}</p>
            </div>
            <div class="layer-text">
              <p class="layer-body">{layer.body}</p>
              <p class="layer-differentiator">{layer.differentiator}</p>
              <p class="layer-crates">{layer.crates.join(' · ')}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .layers-section {
    padding-block: var(--space-3xl);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-header h2 {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block-end: var(--space-sm);
  }

  .section-header :global(.layers-ears) {
    width: 1.25em;
    height: 1.25em;
    flex: none;
  }

  /* The stack: four slabs, each a black block of the name and its text beside it */
  .stack-of-layers {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 4px;
  }

  .layer {
    display: grid;
    grid-template-columns: 16rem minmax(0, 1fr);
    border-block-end: 1px solid var(--hairline);
  }

  .layer-slab {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--space-xs);
    padding: var(--space-md);
    min-height: 100%;
  }

  .layer-name {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    font-weight: var(--font-medium);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .layer-role {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  .layer-text {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-md) 0 var(--space-md) var(--space-lg);
    max-width: 52rem;
  }

  .layer-body {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--ink-secondary);
    text-wrap: pretty;
  }

  .layer-differentiator {
    font-size: var(--text-md);
    font-weight: var(--font-medium);
    line-height: var(--leading-snug);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .layer-crates {
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    line-height: var(--leading-normal);
    color: var(--ink-secondary);
  }

  @media (max-width: 760px) {
    .layers-section {
      padding-block: var(--space-2xl);
    }

    .section-header {
      margin-block-end: var(--space-lg);
    }

    .layer {
      grid-template-columns: minmax(0, 1fr);
      border-block-end: 0;
    }

    .layer-slab {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-sm);
      padding: var(--space-sm) var(--space);
      min-height: 0;
    }

    .layer-text {
      padding: var(--space-sm) 0 var(--space-md);
      gap: var(--space-xs);
    }

    .layer-body {
      font-size: var(--text-sm);
      line-height: 1.5;
    }

    .layer-differentiator {
      font-size: var(--text-base);
    }
  }
</style>
