---
import { layers } from '../data/project';
---

<section class="layers-section" aria-labelledby="layers-title">
  <div class="wrapper">
    <header class="section-header">
      <h2 id="layers-title" class="text-title">Four layers, one system</h2>
      <p class="text-lead">
        Each layer owns a single responsibility. Together they run a local model and let it act.
      </p>
    </header>

    <div class="layers-table" role="table" aria-label="Architecture layers">
      <div class="layers-row layers-header" role="row">
        <span role="columnheader">Layer</span>
        <span role="columnheader">What it does</span>
        <span role="columnheader">What it adds</span>
      </div>
      {
        layers.map((layer, index) => (
          <div class="layers-row" role="row">
            <div class="layer-label" role="cell">
              <span class="layer-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="layer-name">{layer.name}</span>
              <span class="layer-role">{layer.role}</span>
              <span class="layer-crates">{layer.crates.join(' · ')}</span>
            </div>
            <p class="layer-body" role="cell">
              {layer.body}
            </p>
            <p class="layer-differentiator" role="cell">
              {layer.differentiator}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .layers-section {
    padding-block: var(--space-3xl);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-header h2 {
    margin-block-end: var(--space-sm);
  }

  .layers-table {
    display: grid;
    grid-template-columns: 260px 1fr 280px;
    gap: 0;
    border-top: 1px solid var(--hairline);
  }

  .layers-row {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
    border-bottom: 1px solid var(--hairline);
  }

  .layers-header {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .layers-header span {
    padding: var(--space-sm) var(--space-md);
  }

  .layer-label {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-md);
    border-inline-start: 2px solid var(--accent);
  }

  .layer-index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
    font-weight: var(--font-medium);
  }

  .layer-name {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--font-medium);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .layer-role {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .layer-crates {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-secondary);
    line-height: var(--leading-normal);
  }

  .layer-body,
  .layer-differentiator {
    margin: 0;
    padding: var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--ink-secondary);
  }

  .layer-differentiator {
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .layers-table {
      grid-template-columns: 220px 1fr;
    }

    .layers-row {
      grid-template-columns: 220px 1fr;
    }

    .layers-header span:nth-child(3) {
      display: none;
    }

    .layer-differentiator {
      grid-column: 2;
      padding-block-start: 0;
      border-bottom: 1px solid var(--hairline);
    }
  }

  @media (max-width: 760px) {
    .layers-table {
      display: block;
      border-top: 0;
    }

    .layers-row {
      display: block;
      border-bottom: 0;
    }

    .layers-header {
      display: none;
    }

    .layer-label,
    .layer-body,
    .layer-differentiator {
      padding: var(--space-sm) 0;
    }

    .layer-label {
      border-inline-start: 0;
      border-top: 1px solid var(--hairline);
      padding-top: var(--space-md);
    }

    .layer-body {
      padding-top: 0;
    }

    .layer-differentiator {
      border-bottom: 0;
      padding-bottom: var(--space-md);
    }
  }
</style>
