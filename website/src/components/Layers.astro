---
import { layers } from '../data/project';

// One fact per layer, quoted from the data of the project and the README.
// The agent row is open on purpose: it does not finish a task yet.
const facts: Record<string, { kind: 'solid' | 'hollow'; state: string; text: string }> = {
  kernel: { kind: 'solid', state: 'Measured', text: '59 Linux system calls' },
  runtime: { kind: 'solid', state: 'Measured', text: 'Token for token against the reference' },
  agent: { kind: 'hollow', state: 'Open', text: 'Does not finish a task yet: the model repeats a call' },
  network: { kind: 'solid', state: 'Measured', text: 'IPv4, UDP and TCP in the kernel' },
};
import Mark from './Mark.astro';
---

<section class="layers-section on-paper" aria-labelledby="layers-title">
  <div class="wrapper">
    <header class="section-header">
      <h2 id="layers-title" class="text-title">
        Four layers, one system
      </h2>
      <p class="text-lead">
        Each layer owns a single responsibility. Together they run a local model and let it act.
      </p>
    </header>

    <ul class="stack-of-layers" role="list">
      {
        layers.map((layer) => (
          <li class="layer">
            <div class="layer-slab on-ink">
              <h3 class="layer-name">{layer.name}</h3>
              <p class="layer-role">{layer.role}</p>
              <p class="layer-fact">
                <Mark kind={facts[layer.id].kind} label={facts[layer.id].state} />
                <span>{facts[layer.id].text}</span>
              </p>
            </div>
            <div class="layer-text">
              <p class="layer-body">{layer.body}</p>
              <p class="layer-differentiator">{layer.differentiator}</p>
              <p class="layer-crates">{layer.crates.join(' · ')}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .layers-section {
    padding-block: var(--space-3xl);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-header h2 {
    margin-block-end: var(--space-sm);
  }

  /* The stack: four slabs, each a black block of the name and its text beside it */
  .stack-of-layers {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .layer {
    display: grid;
    grid-template-columns: 19rem minmax(0, 1fr);
    border-block-end: 1px solid var(--hairline);
  }

  .layer-slab {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xs);
    padding: var(--space-md);
    min-height: 100%;
    border-block-end: 1px solid rgba(255, 255, 255, 0.24);
  }

  .layer-fact {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    margin-block-start: var(--space-md);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink);
  }

  .layer-fact :global(.mark) {
    --mark-size: 1rem;
    margin-block-start: 0.2rem;
  }

  .layer-name {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    font-weight: var(--font-medium);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .layer-role {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  .layer-text {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-md) 0 var(--space-md) var(--space-lg);
    max-width: 52rem;
  }

  .layer-body {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--ink-secondary);
    text-wrap: pretty;
  }

  .layer-differentiator {
    font-size: var(--text-md);
    font-weight: var(--font-medium);
    line-height: var(--leading-snug);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .layer-crates {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-secondary);
  }

  @media (max-width: 760px) {
    .layers-section {
      padding-block: var(--space-2xl);
    }

    .section-header {
      margin-block-end: var(--space-lg);
    }

    .layer {
      grid-template-columns: minmax(0, 1fr);
      border-block-end: 0;
    }

    .layer-slab {
      padding: var(--space-sm) var(--space);
      min-height: 0;
    }

    .layer-fact {
      margin-block-start: var(--space-xs);
    }

    .layer-text {
      padding: var(--space-sm) 0 var(--space-md);
      gap: var(--space-xs);
    }

    .layer-body {
      font-size: var(--text-sm);
      line-height: 1.5;
    }

    .layer-differentiator {
      font-size: var(--text-base);
    }
  }
</style>
