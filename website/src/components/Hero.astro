---
import { meta, benchmarkContext } from '../data/project';
import { url } from '../lib/paths';
import EarsMark from './EarsMark.astro';

const bootLog = [
  { ts: '0.000', msg: 'Rabbit: boot OK' },
  { ts: '0.012', msg: 'MM DIRECTMAP OK' },
  { ts: '0.018', msg: 'HEAP OK 10000' },
  { ts: '0.041', msg: 'USER OK exit=0' },
  { ts: '0.102', msg: 'SCHED OK' },
  { ts: '1.254', msg: 'TICKS 100' },
  { ts: '2.008', msg: 'INFER OK tokens=42' },
  { ts: '12.9s', msg: 'AGENT loop complete' },
];

---

<section class="hero on-ink" aria-labelledby="hero-title">
  <div class="hero-content wrapper">
    <div class="hero-main">
      <div class="hero-lockup rv" style="--i: 0">
        <h1 id="hero-title" class="hero-word">Rabbit</h1>
        <EarsMark class="hero-ears" />
      </div>
      <p class="hero-tagline rv" style="--i: 1">{meta.tagline}</p>

      <div class="hero-figures rv" style="--i: 2">
        <p class="hero-eyebrow">System call latency</p>
        <dl class="figure-row">
          <div class="figure">
            <dt>Rabbit<span class="figure-ctx">{benchmarkContext}</span></dt>
            <dd>376<span class="figure-unit"> ns</span></dd>
          </div>
          <div class="figure">
            <dt>Linux 7.3.0<span class="figure-ctx">{benchmarkContext}</span></dt>
            <dd>29.3<span class="figure-unit"> µs</span></dd>
          </div>
          <div class="figure">
            <dt>Linux, mitigations off<span class="figure-ctx">{benchmarkContext}</span></dt>
            <dd>1.04<span class="figure-unit"> µs</span></dd>
          </div>
        </dl>
      </div>

      <div class="hero-actions rv" style="--i: 3">
        <a class="button button-primary" href={url('/benchmarks')}>See the measurements</a>
        <a class="button button-secondary" href={meta.repo}>Source on GitHub</a>
      </div>
    </div>

    <dl class="hero-meta">
      <div class="meta-item">
        <dt>Repository</dt>
        <dd>{meta.repoPath}</dd>
      </div>
      <div class="meta-item">
        <dt>License</dt>
        <dd>{meta.license}</dd>
      </div>
      <div class="meta-item">
        <dt>Toolchain</dt>
        <dd>{meta.toolchain}</dd>
      </div>
      <div class="meta-item">
        <dt>ABI</dt>
        <dd>Linux userspace</dd>
      </div>
      <div class="meta-item">
        <dt>Architecture</dt>
        <dd>x86_64</dd>
      </div>
      <div class="meta-item">
        <dt>Status</dt>
        <dd>{meta.status}</dd>
      </div>
    </dl>
  </div>

  <div class="hero-terminal wrapper">
    <div class="terminal-header">
      <span class="terminal-status" aria-hidden="true"></span>
      <span class="terminal-title">serial0</span>
    </div>
    <ol class="terminal-lines" aria-label="Boot log">
      {
        bootLog.map((line, index) => {
          const chars = `[${line.ts}] ${line.msg}`.length;
          return (
            <li class="terminal-line" style={`--chars: ${chars}; --delay: ${index};`}>
              <span class="terminal-ts">[{line.ts}]</span>
              <span class="terminal-msg">{line.msg}</span>
            </li>
          );
        })
      }
    </ol>
    <span class="terminal-cursor" aria-hidden="true"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    padding-block: 26vh 0;
    overflow: hidden;
    isolation: isolate;
  }

  /* The word and the ears are one mark. Sizes of the ears are in em, so
     they follow the word at every width. */
  .hero-lockup {
    position: relative;
    width: fit-content;
    font-size: clamp(3rem, 28vw, 14rem);
    margin-block-end: var(--space-md);
  }

  :global(.hero-ears) {
    position: absolute;
    z-index: -1;
    width: 3.2em;
    height: 3.2em;
    max-width: none;
    /* Above the word, right aligned, cropped by the top edge of the hero */
    inset-inline-end: -0.9em;
    inset-block-end: calc(100% - 0.12em);
    fill: none;
    stroke: var(--ink);
    stroke-width: 2px;
    pointer-events: none;
  }

  :global(.hero-ears path) {
    vector-effect: non-scaling-stroke;
  }

  @media (min-width: 1100px) {
    .hero {
      padding-block-start: var(--space-2xl);
    }
    /* Beside the word, standing on its baseline */
    :global(.hero-ears) {
      inset-inline-end: auto;
      inset-block-end: auto;
      inset-inline-start: calc(100% - 0.75em);
      inset-block-start: -2.18em;
      stroke-width: 3px;
    }
  }

  .hero-content {
    display: grid;
    gap: var(--space-xl);
    align-items: end;
  }

  .hero-main {
    max-width: var(--measure);
  }

  .hero-word {
    font-family: var(--font-display);
    font-size: 1em;
    line-height: 0.9;
    font-weight: 800;
    letter-spacing: -0.06em;
    color: var(--ink);
    margin-inline-start: -0.04em;
  }

  .hero-tagline {
    max-width: 40ch;
    margin-block-end: var(--space-xl);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--ink-secondary);
  }

  .hero-figures {
    margin-block-end: var(--space-lg);
    padding-block-start: var(--space);
    border-top: 1px solid var(--hairline);
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: var(--font-medium);
    margin-block-end: var(--space-sm);
  }

  .figure-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space) var(--space-xl);
    margin: 0;
  }

  .figure dt {
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .figure dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    font-weight: var(--font-medium);
    letter-spacing: -0.04em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /* Rabbit in full ink, the Linux references one step down */
  .figure + .figure dd {
    color: var(--ink-secondary);
  }

  .figure-unit {
    font-size: 0.4em;
    letter-spacing: 0;
    color: var(--muted);
  }

  .figure-ctx {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.72);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* One-time load reveal: transform and opacity only */
  .rv {
    animation: rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 90ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rv {
      animation: none;
    }
  }

  .hero-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin: 0;
    padding-block-start: var(--space-lg);
    border-top: 1px solid var(--hairline);
  }

  .meta-item dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: var(--font-medium);
  }

  .meta-item dd {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink);
    margin: 0;
    margin-block-start: var(--space-xs);
  }

  @media (max-width: 900px) {
    .hero-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 760px) {
    .hero-meta {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-sm);
    }
  }

  .hero-terminal {
    position: relative;
    margin-block-start: var(--space-3xl);
    border: 1px solid var(--hairline);
    border-bottom: 0;
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    background: var(--surface);
    padding: var(--space-md);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block-end: var(--space-sm);
    padding-block-end: var(--space-sm);
    border-bottom: 1px solid var(--hairline);
  }

  .terminal-status {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink);
  }

  .terminal-title {
    margin-inline-start: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: var(--font-medium);
  }

  .terminal-lines {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--code-line-height);
    color: var(--ink-secondary);
  }

  .terminal-line {
    display: flex;
    gap: var(--space-sm);
    overflow: hidden;
    white-space: nowrap;
  }

  .terminal-ts {
    color: var(--muted);
    flex: none;
  }

  .terminal-msg {
    color: var(--ink-secondary);
  }

  .terminal-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.2em;
    background: var(--ink);
    margin-block-start: var(--space-xs);
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Typewriter animation */
  .terminal-line {
    clip-path: inset(0 100% 0 0);
    animation: type calc(var(--chars) * 60ms) steps(var(--chars)) forwards;
    animation-delay: calc(var(--delay) * 600ms);
  }

  .terminal-cursor {
    opacity: 0;
    animation: type 0.1ms forwards, blink 1s step-end infinite;
    animation-delay: calc(8 * 600ms), calc(8 * 600ms + 100ms);
  }

  @keyframes type {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* Reduced motion: show everything, no blink */
  @media (prefers-reduced-motion: reduce) {
    .terminal-line,
    .terminal-cursor {
      animation: none;
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
    .terminal-cursor {
      opacity: 1;
    }
  }

  @media (max-width: 760px) {
    .hero-terminal {
      padding: var(--space);
    }
  }
</style>
