---
import { meta, benchmarkContext } from '../data/project';
import { url } from '../lib/paths';
import EarsMark from './EarsMark.astro';

// Copied from the real serial log of docs/BOOT.md, in its order.
const bootLog = [
  'Rabbit: x86_64 kernel, M4b (SMP)',
  'MM DIRECTMAP OK',
  'Hello from Rabbit userland',
  'USER OK exit=0',
  'MEM OK',
  'HEAP OK 10000',
  'SCHED OK',
  'Rabbit: exception survived',
  'TICKS 100',
  'Rabbit: boot OK',
];

---

<section class="hero on-ink" aria-labelledby="hero-title">
  <div class="hero-top wrapper">
    <div class="hero-lockup rv" style="--i: 0">
      <h1 id="hero-title" class="hero-word">Rabbit</h1>
      <EarsMark class="hero-ears" />
    </div>
  </div>

  <div class="hero-grid wrapper">
    <div class="hero-main">
      <p class="hero-tagline rv" style="--i: 1">{meta.tagline}</p>

      <div class="hero-figures rv" style="--i: 2">
        <p class="hero-eyebrow">System call latency</p>
        <dl class="figure-row">
          <div class="figure">
            <dt>Rabbit<span class="figure-ctx">{benchmarkContext}</span></dt>
            <dd>376<span class="figure-unit"> ns</span></dd>
          </div>
          <div class="figure">
            <dt>Linux 7.3.0<span class="figure-ctx">{benchmarkContext}</span></dt>
            <dd>29.3<span class="figure-unit"> µs</span></dd>
          </div>
          <div class="figure">
            <dt>Linux, mitigations off<span class="figure-ctx">{benchmarkContext}</span></dt>
            <dd>1.04<span class="figure-unit"> µs</span></dd>
          </div>
        </dl>
      </div>

      <div class="hero-actions rv" style="--i: 3">
        <a class="button button-primary" href={url('/benchmarks')}>See the measurements</a>
        <a class="button button-secondary" href={meta.repo}>Source on GitHub</a>
      </div>
    </div>

    <div class="hero-terminal" data-boot-log>
      <div class="terminal-header">
        <span class="terminal-status" aria-hidden="true"></span>
        <span class="terminal-title">serial0</span>
      </div>
      <ol class="terminal-lines" aria-label="Boot log">
        {
          bootLog.map((line, index) => {
            return (
              <li class="terminal-line" style={`--chars: ${line.length}; --delay: ${index};`}>
                <span class="terminal-msg">{line}</span>
              </li>
            );
          })
        }
      </ol>
      <span class="terminal-cursor" aria-hidden="true"></span>
    </div>
  </div>

  <dl class="hero-meta wrapper">
    <div class="meta-item">
      <dt>Repository</dt>
      <dd>{meta.repoPath}</dd>
    </div>
    <div class="meta-item">
      <dt>License</dt>
      <dd>{meta.license}</dd>
    </div>
    <div class="meta-item">
      <dt>Toolchain</dt>
      <dd>{meta.toolchain}</dd>
    </div>
    <div class="meta-item">
      <dt>ABI</dt>
      <dd>Linux userspace</dd>
    </div>
    <div class="meta-item">
      <dt>Architecture</dt>
      <dd>x86_64</dd>
    </div>
    <div class="meta-item">
      <dt>Status</dt>
      <dd>{meta.status}</dd>
    </div>
  </dl>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding-block: 26vh var(--space-xl);
    overflow: hidden;
    isolation: isolate;
  }

  /* The word and the ears are one mark. The ears are sized in em, so they
     follow the word at every width. */
  .hero-lockup {
    position: relative;
    width: fit-content;
    font-size: clamp(3rem, 28vw, 19rem);
    margin-block-end: var(--space-md);
  }

  .hero-word {
    font-family: var(--font-display);
    font-size: 1em;
    line-height: 0.9;
    font-weight: 800;
    letter-spacing: -0.06em;
    color: var(--ink);
    margin-inline-start: -0.04em;
  }

  :global(.hero-ears) {
    position: absolute;
    z-index: -1;
    width: 3.2em;
    height: 3.2em;
    max-width: none;
    /* Narrow: above the word, right aligned, cropped by the top edge */
    inset-inline-end: -0.9em;
    inset-block-end: calc(100% - 0.12em);
    fill: none;
    stroke: var(--ink);
    stroke-width: 2px;
    pointer-events: none;
  }

  :global(.hero-ears path) {
    vector-effect: non-scaling-stroke;
  }

  @media (min-width: 761px) {
    .hero {
      padding-block-start: 16vh;
    }
    .hero-lockup {
      font-size: clamp(3rem, 23vw, 19rem);
    }
    /* Wide: standing on the baseline right after the word, tall, cropped */
    :global(.hero-ears) {
      width: 2.7em;
      height: 2.7em;
      inset-inline-end: auto;
      inset-block-end: auto;
      inset-inline-start: calc(100% - 0.64em);
      inset-block-start: -1.66em;
      stroke-width: 3px;
    }
  }

  .hero-grid {
    display: grid;
    gap: var(--space-xl);
    align-items: start;
  }

  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      gap: var(--space-2xl);
    }
  }

  .hero-tagline {
    max-width: 40ch;
    margin-block-end: var(--space-xl);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--ink-secondary);
  }

  .hero-figures {
    margin-block-end: var(--space-lg);
    padding-block-start: var(--space);
    border-top: 1px solid var(--hairline);
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: var(--font-medium);
    margin-block-end: var(--space);
  }

  .figure-row {
    display: grid;
    gap: var(--space-lg) var(--space-md);
    margin: 0;
  }

  @media (min-width: 900px) {
    .figure-row {
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
    }
  }

  .figure dt {
    font-size: var(--text-sm);
    color: var(--ink);
  }

  .figure dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 3.5rem;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.06em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .figure dd {
      font-size: 3.25rem;
    }
  }

  @media (min-width: 1100px) {
    .figure dd {
      font-size: 4.5rem;
    }
  }

  /* Rabbit in full ink, the Linux references one step down */
  .figure + .figure dd {
    color: var(--ink-secondary);
  }

  .figure-unit {
    font-size: 0.3em;
    font-weight: 500;
    letter-spacing: 0;
    color: rgba(255, 255, 255, 0.7);
  }

  .figure-ctx {
    display: block;
    margin-block: 2px var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* One-time load reveal: transform and opacity only */
  .rv {
    animation: rise 700ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 90ms);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rv {
      animation: none;
    }
  }

  .hero-meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    margin-block: var(--space-2xl) 0;
    padding-block-start: var(--space-lg);
    border-top: 1px solid var(--hairline);
  }

  .meta-item dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: var(--font-medium);
  }

  .meta-item dd {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink);
    margin: 0;
    margin-block-start: var(--space-xs);
  }

  @media (max-width: 900px) {
    .hero-meta {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .hero-terminal {
    position: relative;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background: var(--surface);
    padding: var(--space-md);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-block-end: var(--space-sm);
    padding-block-end: var(--space-sm);
    border-bottom: 1px solid var(--hairline);
  }

  .terminal-status {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink);
  }

  .terminal-title {
    margin-inline-start: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: var(--font-medium);
  }

  .terminal-lines {
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: var(--code-line-height);
    color: var(--ink-secondary);
  }

  .terminal-line {
    display: flex;
    gap: var(--space-sm);
    overflow: hidden;
    white-space: nowrap;
  }

  .terminal-msg {
    color: var(--ink-secondary);
  }

  .terminal-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.2em;
    background: var(--ink);
    margin-block-start: var(--space-xs);
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Typewriter animation */
  .terminal-line {
    clip-path: inset(0 100% 0 0);
    animation: type calc(var(--chars) * 60ms) steps(var(--chars)) forwards;
    animation-delay: calc(var(--delay) * 600ms);
  }

  .terminal-cursor {
    opacity: 0;
    animation: type 0.1ms forwards, blink 1s step-end infinite;
    animation-delay: calc(10 * 600ms), calc(10 * 600ms + 100ms);
  }

  @keyframes type {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* Reduced motion: show everything, no blink */
  @media (prefers-reduced-motion: reduce) {
    .terminal-line,
    .terminal-cursor {
      animation: none;
      clip-path: inset(0 0 0 0);
      opacity: 1;
    }
  }

  @media (max-width: 760px) {
    .hero-terminal {
      padding: var(--space);
    }
  }
</style>
