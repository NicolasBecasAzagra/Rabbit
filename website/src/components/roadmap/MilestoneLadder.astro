---
import { milestones } from '../../data/project';

const stateLabel: Record<string, string> = {
  done: 'Done',
  next: 'Next',
  deferred: 'Deferred',
};

const groups = [
  { title: 'Kernel core', ids: ['M0', 'M1', 'M2', 'M2b', 'M2c', 'M3'] },
  { title: 'Userspace', ids: ['M4', 'M4b', 'M4c', 'E1', 'E2', 'E2b', 'E3a', 'E3b'] },
  { title: 'SMP', ids: ['M9'] },
  { title: 'Network', ids: ['M10', 'M12'] },
  { title: 'Inference runtime', ids: ['E4', 'E5'] },
  { title: 'Agent', ids: ['E6', 'E7', 'E8'] },
  { title: 'Measurement rig', ids: ['M8'] },
  { title: 'Next', ids: ['M11', 'M13'] },
  { title: 'Deferred', ids: ['M5', 'M6', 'M7'] },
];

const byId = new Map(milestones.map((m) => [m.id, m]));
---

<section class="ladder-section" aria-labelledby="ladder-title">
  <div class="wrapper">
    <header class="section-header">
      <h2 id="ladder-title" class="text-title">A ladder of exit criteria</h2>
      <p class="text-lead">
        Every milestone ends with a sentence a machine can check. No hand-waving, no “almost done”.
      </p>
    </header>

    <div class="ladder-groups">
      {
        groups.map((group) => (
          <section class="ladder-group">
            <h3 class="group-title">{group.title}</h3>
            <ol class="milestone-list">
              {group.ids.map((id) => {
                const m = byId.get(id);
                if (!m) return null;
                const stateIcon = m.state === 'done' ? '✓' : m.state === 'next' ? '→' : '—';
                return (
                  <li class={`milestone-item state-${m.state}`}>
                    <details class="milestone-details">
                      <summary>
                        <span class="milestone-id">{m.id}</span>
                        <span class="milestone-name">{m.name}</span>
                        <span class="milestone-state" aria-label={`State: ${stateLabel[m.state]}`}>
                          <span class="state-icon" aria-hidden="true">{stateIcon}</span>
                          <span class="state-text">{stateLabel[m.state]}</span>
                        </span>
                      </summary>
                      <div class="milestone-body">
                        <p class="delivers">{m.delivers}</p>
                        {m.exit && (
                          <p class="criterion">
                            <span>Exit:</span> {m.exit}
                          </p>
                        )}
                        {m.verification && (
                          <p class="criterion">
                            <span>Verification:</span> {m.verification}
                          </p>
                        )}
                      </div>
                    </details>
                  </li>
                );
              })}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ladder-section {
    padding-block: var(--space-3xl);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-header h2 {
    margin-block-end: var(--space-sm);
  }

  .ladder-groups {
    display: grid;
    gap: var(--space-lg);
  }

  .group-title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    letter-spacing: -0.02em;
    margin-block-end: var(--space-sm);
    color: var(--ink);
  }

  .milestone-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--hairline);
  }

  .milestone-item {
    border-bottom: 1px solid var(--hairline);
    background: var(--canvas);
  }

  .milestone-item.state-next {
    background: var(--surface);
    border-inline-start: 3px solid var(--accent);
  }

  .milestone-details summary {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    cursor: pointer;
    list-style: none;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    border-radius: var(--radius-sm);
  }

  .milestone-details summary::-webkit-details-marker {
    display: none;
  }

  .milestone-details summary:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--ring);
  }

  .milestone-details summary:hover {
    background: var(--surface-2);
  }

  .milestone-details summary:active {
    background: var(--surface-2);
  }

  .milestone-id {
    font-family: var(--font-mono);
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .milestone-name {
    color: var(--ink);
  }

  .milestone-state {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: var(--font-medium);
    color: var(--muted);
  }

  .state-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
  }

  .milestone-item.state-done .state-icon {
    color: var(--ink-secondary);
  }

  .milestone-item.state-next .state-icon,
  .milestone-item.state-next .milestone-state {
    color: var(--accent);
  }

  .milestone-body {
    padding: 0 var(--space-md) var(--space-md) calc(3rem + var(--space-md) + var(--space-sm));
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  .milestone-body .delivers {
    margin-block-end: var(--space-sm);
  }

  .criterion {
    margin-block-start: var(--space-xs);
    max-width: var(--measure);
  }

  .criterion span {
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .milestone-details summary {
      grid-template-columns: 2.5rem 1fr auto;
    }
    .milestone-body {
      padding-inline-start: var(--space-md);
    }
  }
</style>
