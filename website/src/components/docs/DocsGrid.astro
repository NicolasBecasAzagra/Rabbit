---
import { url } from '../../lib/paths';
import { docs } from '../../data/project';

const primarySlugs = new Set(['architecture', 'report']);
const primaryDocs = docs.filter((doc) => primarySlugs.has(doc.slug));
const regularDocs = docs.filter((doc) => !primarySlugs.has(doc.slug));
---

<ul class="docs-list">
  {
    primaryDocs.map((doc) => (
      <li>
        <a class="docs-item docs-item-primary" href={url(`/docs/${doc.slug}`)}>
          <span class="docs-marker" aria-hidden="true">→</span>
          <span class="docs-main">
            <span class="docs-title">{doc.title}</span>
            <span class="docs-summary">{doc.summary}</span>
          </span>
          <span class="docs-source">Read</span>
        </a>
      </li>
    ))
  }

  {
    regularDocs.map((doc) => (
      <li>
        <a class="docs-item" href={url(`/docs/${doc.slug}`)}>
          <span class="docs-main">
            <span class="docs-title">{doc.title}</span>
            <span class="docs-summary">{doc.summary}</span>
          </span>
          <span class="docs-source">View source</span>
        </a>
      </li>
    ))
  }
</ul>

<section class="pipeline" aria-labelledby="pipeline-title">
  <h2 id="pipeline-title">How these pages stay in sync</h2>
  <p class="text-body">
    The documents live as Markdown in the repository. On every build, a script copies them into the
    site and renders them with the same layout. What you read here is the same file that lives in
    the repo.
  </p>
</section>

<style>
  .docs-list {
    display: grid;
    gap: var(--space-md);
    margin-block-end: var(--space-xl);
    list-style: none;
    padding: 0;
  }

  .docs-list li {
    margin: 0;
  }

  .docs-item {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--space-md);
    padding: var(--space-md);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .docs-item:hover {
    border-color: var(--rule);
    background: var(--canvas);
  }

  .docs-item:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--ring);
  }

  .docs-item:active .docs-title {
    color: var(--accent);
  }

  .docs-item-primary {
    grid-template-columns: auto 1fr auto;
    gap: var(--space-sm);
    border-color: var(--rule);
  }

  .docs-marker {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
  }

  .docs-main {
    display: grid;
    gap: var(--space-xs);
  }

  .docs-title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--font-medium);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .docs-item-primary .docs-title {
    color: var(--accent);
  }

  .docs-summary {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ink-secondary);
    line-height: var(--leading-normal);
  }

  .docs-source {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: var(--font-medium);
    white-space: nowrap;
  }

  .docs-item:hover .docs-source {
    color: var(--accent);
  }

  .pipeline {
    padding: var(--space-md);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .pipeline h2 {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--font-medium);
    letter-spacing: -0.01em;
    margin-block-end: var(--space-sm);
    color: var(--ink);
  }

  .pipeline .text-body {
    margin: 0;
    max-width: var(--measure);
  }

  @media (max-width: 760px) {
    .docs-item,
    .docs-item-primary {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }

    .docs-source {
      justify-self: start;
    }
  }
</style>
