<script>
  const figure = document.querySelector('.dotplot-figure');
  if (figure && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const svg = figure.querySelector('.dotplot-svg');
    if (svg) {
      svg.classList.add('js-animate');
      const rows = svg.querySelectorAll('.row');
      rows.forEach((row) => (row as HTMLElement).style.opacity = '0');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              rows.forEach((row, i) => {
                (row as HTMLElement).style.transition = `opacity 350ms ease ${i * 40}ms`;
                (row as HTMLElement).style.opacity = '1';
              });
              observer.disconnect();
            }
          });
        },
        { threshold: 0.2 }
      );
      observer.observe(svg);
    }
  }
</script>
