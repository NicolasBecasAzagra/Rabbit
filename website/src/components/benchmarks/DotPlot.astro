---
// The benchmark chart: one card per timing, three bars on a linear scale from
// zero that belongs to that card. (The file keeps its old name.)
import { benchmarks, meta, benchmarkContext } from '../../data/project';
import SeamEars from '../SeamEars.astro';
import { url } from '../../lib/paths';

export interface Props {
  openTable?: boolean;
}

const { openTable = true } = Astro.props;

const seriesNames = {
  rabbit: 'Rabbit',
  mainline: 'Linux 7.3.0',
  mainlineNoMitigations: 'Linux, mitigations off',
} as const;

type SeriesKey = keyof typeof seriesNames;

type Row = {
  metric: string;
  rabbit: string;
  mainline: string;
  mainlineNoMitigations: string;
  group: 'operation' | 'inference' | 'agent';
  comparison?: 'compared' | 'recorded';
};

function parseValue(s: string): { value: number; unit: string; isTime: boolean } {
  const m = s.trim().match(/^([0-9.]+)\s*([a-zA-Z]+(?:\/[a-zA-Z]+)?)$/);
  if (!m) return { value: 0, unit: s, isTime: false };
  const value = parseFloat(m[1]);
  const unit = m[2];
  const isTime = /^(ns|us|ms|s|ms\/MiB|us\/MiB)$/.test(unit);
  return { value, unit, isTime };
}

function toSeconds(value: number, unit: string): number {
  if (unit === 'ns') return value * 1e-9;
  if (unit === 'us' || unit === 'us/MiB') return value * 1e-6;
  if (unit === 'ms' || unit === 'ms/MiB') return value * 1e-3;
  if (unit === 's') return value;
  return value;
}

function formatRatio(n: number): string {
  if (n >= 100) return Math.round(n).toString();
  if (n >= 10) return n.toFixed(1);
  return n.toFixed(2);
}

const baselineNames = {
  mainline: 'Linux 7.3.0',
  mainlineNoMitigations: 'Linux with mitigations off',
} as const;
type BaselineKey = keyof typeof baselineNames;

/** Rabbit against one baseline of the same row: above 1 means Rabbit is better. */
function ratioOf(row: Row, key: BaselineKey): number | null {
  const a = parseValue(row.rabbit);
  const b = parseValue(row[key]);
  if (!a.isTime && a.unit !== 'MB' && a.unit !== 'tok/s') return null;
  let ratio: number;
  if (a.unit === 'tok/s') ratio = a.value / b.value;
  else if (a.unit === 'MB') ratio = b.value / a.value;
  else ratio = toSeconds(b.value, b.unit) / toSeconds(a.value, a.unit);
  return Number.isFinite(ratio) ? ratio : null;
}

/** The multiplier with its baseline in words, a loss stated as a loss. */
const recordedText = 'Recorded, not a comparison of the kernels';
const isRecorded = (row: Row) => row.comparison === 'recorded';

function compare(row: Row, key: BaselineKey): string {
  if (isRecorded(row)) return key === 'mainline' ? recordedText : '';
  const r = ratioOf(row, key);
  if (r === null) return '';
  const unit = parseValue(row.rabbit).unit;
  const name = baselineNames[key];
  if (r > 0.99 && r < 1.01) return `about the same as ${name}`;
  const better = r > 1;
  const n = formatRatio(better ? r : 1 / r);
  const what =
    unit === 'MB' ? (better ? 'less memory than' : 'more memory than')
    : unit === 'tok/s' ? (better ? 'more tokens/s than' : 'fewer tokens/s than')
    : better ? 'faster than' : 'slower than';
  // Memory is described, not scored: it is not a win.
  return unit === 'MB' ? `${n}× ${what} ${name} (described, not a win)` : `${n}× ${what} ${name}`;
}

const processed = benchmarks.map((row) => {
  const parsed = {
    rabbit: parseValue(row.rabbit),
    mainline: parseValue(row.mainline),
    mainlineNoMitigations: parseValue(row.mainlineNoMitigations),
  };
  return { row, parsed };
});

const operationRows = processed.filter(
  ({ parsed }) =>
    parsed.rabbit.isTime &&
    toSeconds(parsed.rabbit.value, parsed.rabbit.unit) <= 0.1 &&
    parsed.rabbit.unit !== 's'
);

const endToEndRows = processed.filter(
  ({ parsed }) =>
    parsed.rabbit.isTime &&
    (toSeconds(parsed.rabbit.value, parsed.rabbit.unit) > 0.1 || parsed.rabbit.unit === 's')
);

const otherRows = processed.filter(({ parsed }) => !parsed.rabbit.isTime);

const words = ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve'];
const timingRows = [...operationRows, ...endToEndRows];
const timingWord = words[timingRows.length] ?? String(timingRows.length);
// The heading says what holds, over the compared rows only (the boot is recorded, not compared).
// The build fails if Rabbit is not faster than default Linux in every compared timing, and the
// part about the mitigations-off build is counted from the same rows.
const comparedRows = timingRows.filter(({ row }) => !isRecorded(row));
const comparedWord = words[comparedRows.length] ?? String(comparedRows.length);
for (const { row } of comparedRows) {
  const r = ratioOf(row, 'mainline');
  if (r === null || !(r > 1)) throw new Error(`[benchmarks] "${row.metric}" is not faster on Rabbit than Linux 7.3.0; the heading would be false`);
}
const fasterThanNoMit = comparedRows.filter(({ row }) => (ratioOf(row, 'mainlineNoMitigations') ?? 0) > 1).length;
const recordedNote = timingRows.length > comparedRows.length ? '; the boot is recorded, not compared' : '';
const headline =
  fasterThanNoMit === comparedRows.length
    ? `Under QEMU TCG, an emulator, Rabbit is faster than Linux 7.3.0 and than Linux with mitigations off in all ${comparedWord} compared timings${recordedNote}.`
    : `Under QEMU TCG, an emulator, Rabbit is faster than Linux 7.3.0 in all ${comparedWord} compared timings and than Linux with mitigations off in ${words[fasterThanNoMit] ?? fasterThanNoMit} of ${comparedWord}${recordedNote}.`;

// Order of the bars in every card.
const barKeys: SeriesKey[] = ['rabbit', 'mainlineNoMitigations', 'mainline'];

/** Bar lengths of one card, linear from zero: the slowest of the three is 100%. */
function barsOf(row: Row) {
  const seconds = barKeys.map((key) => {
    const p = parseValue(row[key]);
    return toSeconds(p.value, p.unit);
  });
  const max = Math.max(...seconds);
  return barKeys.map((key, i) => ({ key, percent: (seconds[i] / max) * 100 }));
}

/** A comparison split into its factor and its words, to set the factor large. */
function verdict(row: Row, key: BaselineKey) {
  const text = compare(row, key);
  const m = text.match(/^([0-9.]+×) (.*)$/);
  return m ? { factor: m[1], words: m[2] } : { factor: '', words: text };
}

const groups = [
  { id: 'bench-operations', title: 'Kernel operations', rows: operationRows },
  { id: 'bench-end-to-end', title: 'End-to-end', rows: endToEndRows },
];
---

<section id="benchmarks" class="bench-section bench-band on-paper" aria-labelledby="benchmarks-chart-title">
  <SeamEars edge="top" side="right" reach="12rem" />
  <div class="wrapper">
    <header class="section-header">
      <h2 id="benchmarks-chart-title" class="text-title">{headline}</h2>
      <p class="text-lead">
        Lower is faster. {benchmarkContext}, on the same rig, without hardware acceleration. The
        raw table is one click below and contains every measurement, including the losses.
      </p>
    </header>

    <div class="bench-chart">
      {
        groups.map((group) => (
          <div class="bench-group">
            <div class="group-head">
              <h3 id={group.id} class="group-title">{group.title}</h3>
            </div>
            <ul class="cards" role="list" aria-labelledby={group.id}>
              {group.rows.map(({ row }) => {
                const headlineVerdict = verdict(row, 'mainlineNoMitigations');
                return (
                  <li class="bench-card">
                    <h4 class="card-title">{row.metric}</h4>
                    {isRecorded(row) ? (
                      <p class="card-recorded">
                        <a href={url('/docs/benchmarking')}>{recordedText}</a>
                      </p>
                    ) : (
                      <div class="card-verdict">
                        <p class="verdict-main">
                          {headlineVerdict.factor && <span class="verdict-factor">{headlineVerdict.factor}</span>}{' '}
                          <span class="verdict-words">{headlineVerdict.words}</span>
                        </p>
                        <p class="verdict-other">{compare(row, 'mainline')}</p>
                      </div>
                    )}
                    <ul class="bars" role="list">
                      {barsOf(row).map(({ key, percent }) => (
                        <li class={`bar-row bar-${key}`}>
                          <span class="bar-name">{seriesNames[key]}<span class="sr-only">: </span></span>
                          <span class="bar-value">{row[key]}</span>
                          {!isRecorded(row) && (
                            <span class="bar-track" aria-hidden="true">
                              <span class="bar-fill" style={`width:${percent.toFixed(3)}%`} />
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                    <p class="card-context">{benchmarkContext} · lower is better</p>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }

      <p class="bench-note">
        Each card has its own linear scale that starts at zero. Compare bar lengths within a card,
        not between cards.
      </p>

      <details class="raw-table" open={openTable}>
        <summary>The numbers behind the chart: memory, throughput and all {benchmarks.length} raw measurements</summary>
        {otherRows.length > 0 && (
          <div class="other-comparisons">
            <p class="other-title">Memory and throughput</p>
            <div class="other-grid">
              <div class="other-row other-header" aria-hidden="true">
                <span class="other-metric">Metric</span>
                <span class="other-values">
                  <span class="series-rabbit">Rabbit</span>
                  <span class="series-mainline">Linux 7.3.0</span>
                  <span class="series-nomit">Linux, mitigations off</span>
                </span>
                <span class="other-ratio">Ratio</span>
              </div>
              {otherRows.map(({ row }) => (
                <div class="other-row">
                  <span class="other-metric">{row.metric}</span>
                  <span class="other-values">
                    <span class="series-rabbit">{row.rabbit}</span>
                    <span class="series-mainline">{row.mainline}</span>
                    <span class="series-nomit">{row.mainlineNoMitigations}</span>
                  </span>
                  <span class="other-ratio">{compare(row, 'mainline')}<br />{compare(row, 'mainlineNoMitigations')}</span>
                </div>
              ))}
            </div>
          </div>
        )}


        <p class="raw-title">Raw measurements, {benchmarkContext}</p>
        <div class="table-wrap" tabindex="0" role="region" aria-label="Raw benchmark measurements table">
          <table>
            <thead>
              <tr>
                <th scope="col">Metric</th>
                <th scope="col">Rabbit</th>
                <th scope="col">Linux 7.3.0</th>
                <th scope="col">Linux, mitigations off</th>
              </tr>
            </thead>
            <tbody>
              {benchmarks.map((row) => (
                <tr>
                  <th scope="row">{row.metric}</th>
                  <td class="tabular">{row.rabbit}</td>
                  <td class="tabular">{row.mainline}</td>
                  <td class="tabular">{row.mainlineNoMitigations}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </div>

    <p class="section-footer">
      <a href={`${meta.repo}/blob/main/REPORT.md`}>Read the full report</a>
      <a href={url('/docs/benchmarking')}>Methodology</a>
    </p>
  </div>
</section>

<style>
  .bench-section {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-3xl);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-header h2 {
    margin-block-end: var(--space-md);
  }

  .bench-group + .bench-group {
    margin-block-start: var(--space-xl);
  }

  .group-head {
    padding-block-end: var(--space-sm);
    border-block-end: 1px solid var(--ink);
    margin-block-end: var(--space-md);
  }

  .group-title {
    font-size: var(--text-lg);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-md);
    list-style: none;
    padding: 0;
  }

  .bench-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-md);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background: var(--canvas);
  }

  .card-title {
    font-size: var(--text-md);
    letter-spacing: -0.01em;
  }

  .card-verdict,
  .card-recorded {
    margin-block: var(--space-sm) var(--space-md);
  }

  .verdict-factor {
    display: block;
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--leading-snug);
    letter-spacing: -0.03em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .verdict-words {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--ink);
  }

  .verdict-other,
  .card-recorded {
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  .verdict-other {
    margin-block-start: var(--space-xs);
  }

  /* Pushed to the foot so the bars line up across a row of cards */
  .bars {
    display: grid;
    gap: var(--space);
    list-style: none;
    padding: 0;
    margin-block-start: auto;
  }

  .bar-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-xs) var(--space-sm);
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  .bar-value {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--ink);
  }

  /* The left edge of the track is zero */
  .bar-track {
    grid-column: 1 / -1;
    display: block;
    height: 0.875rem;
    border-inline-start: 1px solid var(--rule);
  }

  /* The 2px floor keeps a very short bar visible; the label has the exact value */
  .bar-fill {
    display: block;
    height: 100%;
    min-width: 2px;
    border: 1px solid var(--muted);
    background: var(--surface-2);
  }

  .bar-rabbit .bar-name,
  .bar-rabbit .bar-value {
    font-weight: var(--font-semibold);
    color: var(--accent);
  }

  .bar-rabbit .bar-fill {
    border-color: var(--accent);
    background: var(--accent);
  }

  .card-context {
    margin-block-start: var(--space);
    padding-block-start: var(--space-sm);
    border-block-start: 1px solid var(--hairline);
    font-size: var(--text-caption);
    color: var(--ink-secondary);
  }

  @media (forced-colors: active) {
    .bar-fill {
      border-color: CanvasText;
    }

    .bar-rabbit .bar-fill {
      background: CanvasText;
    }
  }

  .other-comparisons {
    margin-block-start: var(--space-md);
    padding-block: var(--space-md);
  }

  .other-title {
    font-family: var(--font-body);
    font-size: var(--text-caption);
    font-weight: var(--font-medium);
    color: var(--ink);
    margin-block-end: var(--space-sm);
  }

  .other-grid {
    display: grid;
    gap: var(--space-sm);
  }

  .other-row {
    display: grid;
    grid-template-columns: 1.5fr 1.5fr 1fr;
    align-items: baseline;
    gap: var(--space-sm);
    padding: var(--space-sm) 0;
    border-bottom: 1px solid var(--hairline);
    font-family: var(--font-body);
    font-size: var(--text-sm);
  }

  .other-row:first-child {
    border-top: 1px solid var(--hairline);
  }

  .other-header {
    font-family: var(--font-mono);
    font-weight: var(--font-medium);
    color: var(--ink-secondary);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: var(--text-caption);
  }

  .other-metric {
    color: var(--ink);
  }

  .other-values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .series-rabbit {
    color: var(--accent);
  }

  .series-mainline {
    color: var(--ink-secondary);
  }

  .series-nomit {
    color: var(--ink-secondary);
  }

  .other-ratio {
    text-align: end;
    color: var(--accent);
    font-size: var(--text-caption);
  }

  .bench-note {
    margin-block-start: var(--space-md);
    font-size: var(--text-sm);
    color: var(--ink-secondary);
  }

  .raw-table {
    margin-block-start: var(--space-lg);
    border-block: 1px solid var(--rule);
  }

  .raw-title {
    margin-block: var(--space-lg) var(--space-xs);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--ink);
  }

  .raw-table summary {
    padding: var(--space) 0;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    color: var(--ink);
    cursor: pointer;
  }

  .raw-table summary:hover {
    background: var(--surface);
  }

  .raw-table summary:focus-visible {
    outline-offset: -2px;
    border-radius: 0;
  }

  .raw-table .table-wrap {
    overflow-x: auto;
    padding-block-end: var(--space-sm);
  }

  .raw-table .table-wrap:focus-visible {
    outline-offset: -2px;
  }

  .raw-table table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .raw-table th,
  .raw-table td {
    padding: var(--space-sm) var(--space-md);
    border-top: 1px solid var(--hairline);
    text-align: left;
    font-variant-numeric: tabular-nums;
  }

  .raw-table td {
    text-align: right;
  }

  .raw-table th {
    color: var(--ink-secondary);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    font-weight: var(--font-medium);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .raw-table tbody th {
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    text-transform: none;
    letter-spacing: 0;
    text-align: left;
  }

  .section-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-lg);
    margin-block-start: var(--space-xl);
    font-size: var(--text-base);
    font-weight: var(--font-medium);
  }

  @media (max-width: 760px) {
    .other-row {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
    }
    .other-ratio {
      text-align: start;
    }
  }
</style>
