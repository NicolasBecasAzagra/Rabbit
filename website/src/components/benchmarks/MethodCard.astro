---
import { benchmarkMethod } from '../../data/project';
---

<section class="method-section" aria-labelledby="method-title">
  <div class="wrapper">
    <header class="section-header">
      <h2 id="method-title" class="text-title">How the numbers are produced</h2>
    </header>

    <div class="method-body">
      <p class="method-headline">{benchmarkMethod.headline}</p>
      <p class="text-body">{benchmarkMethod.detail}</p>
    </div>
  </div>
</section>

<style>
  .method-section {
    padding-block: var(--space-3xl);
  }

  .section-header {
    max-width: var(--measure);
    margin-block-end: var(--space-xl);
  }

  .section-header h2 {
    margin-block-end: var(--space-sm);
  }

  .method-body {
    max-width: var(--measure);
    padding: var(--space-md);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .method-headline {
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: var(--font-medium);
    color: var(--ink);
    margin-block-end: var(--space-xs);
  }
</style>
